# Copy to .env and edit. Read by docker compose.
SIEMGEN_SEED=1337          # your group's number: same seed => same company, same logs, anywhere
SIEMGEN_ORG=acme-corp      # company name; "blue-team" gives blue.local hosts and the BLUE Windows domain
SIEMGEN_USERS=20           # employees (each one gets a workstation)
SIEMGEN_DAYS=14            # days of history written before the live feed starts
SIEMGEN_MODE=both          # history | live | both
SIEMGEN_SPEED=1            # live time compression: 1 = real time, 12 = one simulated day per 2 h

# Make the generated files belong to you instead of uid 1000 (Linux/macOS: run `id -u` / `id -g`)
PUID=1000
PGID=1000
